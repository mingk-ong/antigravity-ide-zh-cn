{
  "name": "antigravity-ide-zh-cn",
  "version": "1.7.0",
  "description": "Antigravity IDE（反重力）深度全量汉化与使用体验优化工具包（全界面四阵地汉化、标题/思维链流式翻译、思维链点击交互优化、Markdown 表格自适应布局与跨版本自愈）",
  "main": "src/patcher.js",
  "scripts": {
    "patch": "node src/patcher.js",
    "verify": "node src/verifier.js",
    "verify:ui": "node verify_full_ui_localization.js",
    "verify:screens": "node verify_all_14_screens.js",
    "verify:titles": "node verify_title_localization.js",
    "verify:thoughts": "node verify_thought_localization.js",
    "verify:tables": "node verify_table_responsive.js",
    "restore": "node src/restore.js"
  },
  "keywords": [
    "antigravity",
    "ide",
    "chinese-patch",
    "zh-cn",
    "localization",
    "checksum-protection"
  ],
  "author": {
    "name": "mingk-ong",
    "url": "https://github.com/mingk-ong"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mingk-ong/antigravity-ide-zh-cn.git"
  },
  "homepage": "https://github.com/mingk-ong/antigravity-ide-zh-cn#readme",
